# ESP32_CIS_V1.0 · CIS 配置（实施计划 §4）

menu "CIS Configuration"

choice CIS_MODE
    prompt "CIS working mode"
    default CIS_MODE_ROUTER
    help
        ROUTER：全节点连同一路由器，信道跟随 AP（默认）。
        DIRECT：无路由场地，RX 固定信道混杂直收 TX 的 ESP-NOW 广播。
    config CIS_MODE_ROUTER
        bool "Router mode (all nodes join same AP)"
    config CIS_MODE_DIRECT
        bool "Direct mode (fixed channel promiscuous RX)"
endchoice

config CIS_DEFAULT_CHANNEL
    int "Default WiFi channel (radar init / direct mode / SoftAP fallback)"
    range 1 14
    default 6
    help
        路由器 2.4G 固定信道（实施计划 §7：信道 6）。esp-radar 以此信道起收，
        ROUTER 模式下 STA 连上后自动跟随 AP。

config CIS_UDP_REPORT_DEFAULT
    bool "Enable UDP report by default (port 3333)"
    default n

config CIS_UDP_REPORT_PORT
    int "UDP report port"
    range 1 65535
    default 3333

config CIS_TCP_CONSOLE_PORT
    int "TCP console port (wireless calibration REPL)"
    range 1 65535
    default 2323

config CIS_FEATURE_RATE_HZ
    int "Feature stream (0x11) rate per peer (Hz)"
    range 1 50
    default 10

config CIS_MOTION_CONFIRM_FRAMES
    int "Motion confirm windows N (consecutive over-threshold)"
    range 1 100
    default 12
    help
        连续 N 窗超阈判运动（12 窗 @10Hz = 1.2s 滞回）。
        2026-10-30 夜间 3.6h 静置实测：最弱链路（S3→经典#1）最大连续
        超阈 9 窗，距 N=10 仅差 1；提到 12 留 33% 裕量，代价仅 +200ms
        检测延迟（人穿过区域的持续扰动远长于 1.2s）。

config CIS_STILL_CONFIRM_FRAMES
    int "Still confirm windows M (consecutive under-threshold)"
    range 1 200
    default 25
    help
        连续 M 窗低于阈值判静止 → PRESENCE（25 窗 @10Hz = 2.5s，满足
        M2 判据"停走 3s 内 EVENT STILL"）。

config CIS_PRESENCE_HOLD_S
    int "Presence hold seconds before returning to IDLE"
    range 1 300
    default 10

config CIS_DEFAULT_THRESHOLD
    int "Default detection threshold before training (centi-var)"
    range 1 65535
    default 30
    help
        未 train 时的初始阈值（var 刻度 = raw² × 100；M1 静态噪声底 ≈ 1）。

config CIS_TRAIN_SECONDS
    int "Default train duration (seconds)"
    range 5 300
    default 15

config CIS_TRAIN_MARGIN_PCT
    int "Train threshold margin over noise floor (percent)"
    range 100 1000
    default 300
    help
        阈值 = 噪声底 × margin/100。验收可 `threshold <mac> <val>` ±10~20% 微调。

config CIS_TRAIN_MIN_THRESHOLD
    int "Train minimum absolute threshold (centi-var)"
    range 1 65535
    default 15

config CIS_NODE_SELF_ID
    int "Observer id of this node (= own CSI source MAC last byte)"
    range 0 3
    default 3
    help
        observer_id ≡ 本节点 CSI 源 MAC 末字节（cis_protocol.h 头注释）。S3 RX 于
        cis_mesh 启动时把 STA 源 MAC 设为 1a:00:00:00:00:0x（x=此处取值，默认 3，
        即 1a:00:00:00:00:03），与 TX 板 csi_send 的 esp_wifi_set_mac 同机制；
        并与 PC 端 MAC_DEVICE_MAP 按末字节映射对齐：
        0x00=经典#1 TX1 / 0x01=C3 TX2 / 0x02=经典#2 TX3 / 0x03=S3 RX。

config CIS_MESH_ENABLE
    bool "Enable ESP-NOW mesh aggregation (cis_mesh, multi-node)"
    default y
    help
        S3 汇聚其它节点经 ESP-NOW 上来的窗口特征（12 链路统一发 0x12/0x13/0x14）。
        置 n 为单机回退：不设源 MAC、不起 ESP-NOW/链路表，仅本地雷达链路工作。

config CIS_MESH_SRC_RATE_HZ
    int "Mesh CSI source frame broadcast rate (Hz)"
    range 10 200
    default 100
    help
        S3 的 ESP-NOW 广播源帧频率（4B 计数器，与 TX 板 csi_send 同构——这是
        其它节点把 S3 当 CSI 源的时钟）。全网若需降载（链路丢包 >10%）必须
        各节点同步修改，否则窗口密度失衡。

config CIS_MESH_FEATURE_RATE_HZ
    int "Expected FEAT_BUNDLE rate per observer (Hz)"
    range 1 50
    default 10
    help
        其它节点特征打包（FEAT_BUNDLE）单播 S3 的标称频率；mesh 以 2×周期判
        链路新鲜度（`link list` 的 stale 标记）。

config CIS_LEGACY_FRAMES
    bool "Also emit legacy 0x10/0x11/0x30 frames for local links (regression)"
    default n
    help
        回归对照开关：置 y 时本地链路（observer=self）在 0x12/0x13/0x14 之外
        同时补发旧版 0x10/0x11/0x30 帧（单机格式），供 PC 端新旧数据流同捕比对。
        默认 n：统一只发多节点帧，旧帧转为遗留格式（PC 保留解析以兼容旧 CSV/回放）。

endmenu
