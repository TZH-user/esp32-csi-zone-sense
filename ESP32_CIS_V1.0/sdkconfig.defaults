#
# ESP32_CIS_V1.0 sdkconfig.defaults
# 移植自 F:\ESP\esp-csi\examples\esp-radar\console_test\sdkconfig.defaults，
# 按实施计划 §4 调整：主 console 改 USB-Serial-JTAG（COM3）、16MB flash、Octal PSRAM。
#

#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_BAUD_921600B=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_MONITOR_BAUD_2MB=y

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

#
# Wi-Fi
#
CONFIG_ESP32_WIFI_CSI_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=

#
# Console：主 console = USB-Serial-JTAG（COM3 串口面 MI_00）
# IDF 5.5.6 中主 console 选 USB-Serial-JTAG 后，secondary 只能选 NONE
# （esp_system/Kconfig: ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG depends on !ESP_CONSOLE_USB_SERIAL_JTAG）
#
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

#
# Common ESP-related
#
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

#
# Compiler options
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000

#
# ESP32S3-specific
#
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=32

#
# PSRAM（S3#1: 16MB flash + 8MB Octal PSRAM，见实施计划 §2）
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
